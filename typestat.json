{
  "include": ["src/**/*.ts"],
  "package": "./package.json",
  "fixes": {
    "incompleteTypes": true,
    "missingProperties": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNonNullAssertions": true
  },
  "types": {
    "strictNullChecks": true,
    "matching": {
      "position|point|coordinate": "GeoJSON.Position",
      "geometry": "GeoJSON.Geometry"
    }
  }
}
